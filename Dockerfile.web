FROM rust:1.97-bookworm AS api-builder
WORKDIR /app
COPY backend/Cargo.toml backend/Cargo.lock ./backend/
COPY backend/src ./backend/src
COPY db ./db
WORKDIR /app/backend
RUN cargo build --locked --release

FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS web-builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV API_INTERNAL_URL=http://127.0.0.1:8080
ENV SKIP_BUILD_TYPECHECK=1
ENV CBGPU_CONSTRAINED_BUILD=1
ENV NODE_OPTIONS=--max-old-space-size=1024
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=api-builder /app/backend/target/release/delibot-api /tmp/delibot-api
COPY . .
RUN npm run build -- --webpack

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 delibot \
    && useradd --system --uid 10001 --gid delibot --create-home delibot \
    && mkdir -p /data/uploads \
    && chown -R delibot:delibot /data
COPY --from=web-builder /tmp/delibot-api /usr/local/bin/delibot-api
COPY --from=api-builder --chown=delibot:delibot /app/db /db
COPY --from=web-builder --chown=delibot:delibot /app/public ./public
COPY --from=web-builder --chown=delibot:delibot /app/.next/standalone ./
COPY --from=web-builder --chown=delibot:delibot /app/.next/static ./.next/static
COPY --chown=delibot:delibot docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod 755 /usr/local/bin/docker-entrypoint
USER delibot
EXPOSE 3000 8080
CMD ["docker-entrypoint"]
